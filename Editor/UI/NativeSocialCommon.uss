/* NativeSocial Common USS Stylesheet */

.ns-root {
    flex-grow: 1;
    background-color: #11141c;
    color: #e2e8f0;
    font-size: 12px;
}

.ns-banner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #0d1b2a;
    border-bottom-width: 1px;
    border-bottom-color: #0077b6;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.ns-banner-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #00b4d8;
}

.ns-banner-subtitle {
    font-size: 11px;
    color: #90e0ef;
    margin-top: 2px;
}

.ns-tab-bar {
    flex-direction: row;
    background-color: #16202e;
    border-bottom-width: 1px;
    border-bottom-color: #263852;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 0px;
}

.ns-tab-btn {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-right: 4px;
    color: #94a3b8;
    -unity-font-style: bold;
    font-size: 12px;
}

.ns-tab-btn:hover {
    background-color: #1d2c3f;
    color: #f1f5f9;
}

.ns-tab-btn-active {
    background-color: #1e334a;
    border-bottom-color: #00b4d8;
    color: #38bdf8;
}

.ns-body {
    flex-grow: 1;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.ns-card {
    background-color: #17202f;
    border-width: 1px;
    border-color: #283950;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    margin-bottom: 12px;
}

.ns-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #233144;
    padding-bottom: 8px;
}

.ns-card-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #f8fafc;
}

.ns-card-desc {
    font-size: 11px;
    color: #94a3b8;
    white-space: normal;
    margin-bottom: 10px;
}

.ns-row {
    flex-direction: row;
    align-items: center;
}

.ns-badge {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
}

.ns-badge-success {
    background-color: #064e3b;
    color: #6ee7b7;
}

.ns-badge-warning {
    background-color: #78350f;
    color: #fcd34d;
}

.ns-badge-error {
    background-color: #7f1d1d;
    color: #fca5a5;
}

.ns-badge-neutral {
    background-color: #1e293b;
    color: #94a3b8;
}

.ns-btn-primary {
    background-color: #0284c7;
    color: #ffffff;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    -unity-font-style: bold;
}

.ns-btn-primary:hover {
    background-color: #0369a1;
}

.ns-btn-secondary {
    background-color: #1e293b;
    border-width: 1px;
    border-color: #334155;
    color: #cbd5e1;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.ns-btn-secondary:hover {
    background-color: #334155;
    color: #ffffff;
}

.ns-code-block {
    background-color: #0b0f19;
    border-width: 1px;
    border-color: #1e293b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    color: #38bdf8;
    font-size: 11px;
    white-space: normal;
}
